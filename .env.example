# Copy to .env.local and fill in. .env.local is gitignored and never committed.
#
# For the Vercel deployment, set these in the Vercel dashboard under
# Project -> Settings -> Environment Variables. Do not commit real values.

# ---- Required ----

# From https://console.anthropic.com -> API keys -> Create key.
# Set a monthly spend limit in the Console as well. It is the only cap that
# cannot be bypassed by a bug in this application's own accounting.
ANTHROPIC_API_KEY=sk-ant-...

# Shared passcode for the hosted demo. Anything memorable; it goes in the email
# alongside the link. Gates the whole site.
DEMO_PASSCODE=change-me

# Signs the session cookie the passcode gate issues. Any long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-32-plus-random-bytes

# ---- Optional ----

# Durable rate limits, spend cap, and the cross-visitor attack log. Without
# these the system still works, but those counters are per-instance and reset
# when a serverless instance recycles. Free tier at https://upstash.com ->
# Redis -> REST API.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Override the daily spend cap in USD. Defaults to config/agent.config.json.
# DAILY_SPEND_CAP_USD=15
